<pre class="cm-content q9tKkq_readonly m-0"><code><span class="ͼv">import</span> <span class="ͼ11">java</span><span class="ͼv">.</span><span class="ͼ11">util</span><span class="ͼv">.</span><span class="ͼ11">concurrent</span><span class="ͼv">.</span><span class="ͼ11">atomic</span><span class="ͼv">.</span><span class="ͼ11">AtomicInteger</span>;

<span class="ͼv">public</span> <span class="ͼv">class</span> <span class="ͼ11">DataRaceFixed</span> {

    <span class="ͼv">static</span> <span class="ͼ11">AtomicInteger</span> <span class="ͼ11">counter</span> <span class="ͼv">=</span> <span class="ͼv">new</span> <span class="ͼ11">AtomicInteger</span>(<span class="ͼy">0</span>);

    <span class="ͼv">public</span> <span class="ͼv">static</span> <span class="ͼv">void</span> <span class="ͼ11">main</span>(<span class="ͼ11">String</span>[] <span class="ͼ11">args</span>) <span class="ͼv">throws</span> <span class="ͼ11">Exception</span> {

        <span class="ͼ11">int</span> <span class="ͼ11">threads</span> <span class="ͼv">=</span> <span class="ͼy">10</span>;
        <span class="ͼ11">int</span> <span class="ͼ11">increments</span> <span class="ͼv">=</span> <span class="ͼy">1_000_000</span>;

        <span class="ͼ11">Thread</span>[] <span class="ͼ11">workers</span> <span class="ͼv">=</span> <span class="ͼv">new</span> <span class="ͼ11">Thread</span>[<span class="ͼ11">threads</span>];

        <span class="ͼv">for</span> (<span class="ͼ11">int</span> <span class="ͼ11">i</span> <span class="ͼv">=</span> <span class="ͼy">0</span>; <span class="ͼ11">i</span> <span class="ͼv">&lt;</span> <span class="ͼ11">threads</span>; <span class="ͼ11">i</span><span class="ͼv">++</span>) {

            <span class="ͼ11">workers</span>[<span class="ͼ11">i</span>] <span class="ͼv">=</span> <span class="ͼv">new</span> <span class="ͼ11">Thread</span>(() -&gt; {

                <span class="ͼv">for</span> (<span class="ͼ11">int</span> <span class="ͼ11">j</span> <span class="ͼv">=</span> <span class="ͼy">0</span>; <span class="ͼ11">j</span> <span class="ͼv">&lt;</span> <span class="ͼ11">increments</span>; <span class="ͼ11">j</span><span class="ͼv">++</span>) {
                    <span class="ͼ11">counter</span><span class="ͼv">.</span><span class="ͼ11">incrementAndGet</span>();
                }

            });

            <span class="ͼ11">workers</span>[<span class="ͼ11">i</span>]<span class="ͼv">.</span><span class="ͼ11">start</span>();
        }

        <span class="ͼv">for</span> (<span class="ͼ11">Thread</span> <span class="ͼ11">worker</span> : <span class="ͼ11">workers</span>) {
            <span class="ͼ11">worker</span><span class="ͼv">.</span><span class="ͼ11">join</span>();
        }

        <span class="ͼ11">System</span><span class="ͼv">.</span><span class="ͼ11">out</span><span class="ͼv">.</span><span class="ͼ11">println</span>(<span class="ͼz">"Expected: "</span> <span class="ͼv">+</span> <span class="ͼ11">threads</span> <span class="ͼv">*</span> <span class="ͼ11">increments</span>);
        <span class="ͼ11">System</span><span class="ͼv">.</span><span class="ͼ11">out</span><span class="ͼv">.</span><span class="ͼ11">println</span>(<span class="ͼz">"Actual:   "</span> <span class="ͼv">+</span> <span class="ͼ11">counter</span><span class="ͼv">.</span><span class="ͼ11">get</span>());
    }
}</code></pre>
